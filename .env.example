# ══════════════════════════════════════════════════════════════════════════
# Kolek — variables de entorno
#
# Copia este archivo como .env.local y llena SOLO lo que ya tengas. Ninguna
# integración es obligatoria para que la app arranque: sin credenciales,
# Kolek activa automáticamente su modo mock/manual correspondiente y avisa
# "Modo de prueba" en la UI. Ver docs/integrations.md para el detalle de
# cada una y README.md > "Checklist de producción" para qué llenar antes
# del primer piloto real.
#
# Nunca pongas valores reales aquí ni los subas al repo — este archivo es
# la plantilla, se queda vacío a propósito.
# ══════════════════════════════════════════════════════════════════════════

# ── APLICACIÓN ──────────────────────────────────────────────────────────
# URL pública de la app, sin slash final. En local: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# ── BASE DE DATOS / AUTENTICACIÓN (Supabase) — REQUERIDAS ────────────────
# Supabase Dashboard > Project Settings > API. Sin esto la app no arranca
# (ver instrumentation.ts) — Auth, Postgres y RLS usan el mismo proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key: NUNCA la expongas al cliente. Solo la usan route
# handlers y server components (webhooks, /p/[token], cron, superadmin).
SUPABASE_SERVICE_ROLE_KEY=

# ── CIFRADO ───────────────────────────────────────────────────────────────
# Llave simétrica (32+ caracteres) para cifrar en reposo las credenciales
# de integraciones reales (tokens de Mercado Pago obtenidos por OAuth).
# Sin ella, Kolek se niega a GUARDAR una conexión real — el modo mock sigue
# funcionando igual. Genera una con: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# ── MERCADO PAGO (OAuth — nunca "pega tu access token") ───────────────────
# App de Kolek registrada en el panel de desarrolladores de Mercado Pago.
# Sin esto, PAYMENT_PROVIDER_MODE se queda en 'mock' automáticamente.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=
MERCADOPAGO_WEBHOOK_SECRET=
# 'mock' (default, sin cargos reales) | 'mercadopago'
PAYMENT_PROVIDER_MODE=mock

# ── WHATSAPP CLOUD API (Meta) ──────────────────────────────────────────────
# developers.facebook.com > tu app > WhatsApp > Configuración de la API.
# Sin esto, los recordatorios quedan listos para mandar a mano (wa.me) —
# nada se pierde, nada se marca "enviado" sin haberse mandado de verdad.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# 'manual' (default) | 'whatsapp_cloud' | 'mock' (solo para probar demos)
MESSAGING_PROVIDER_MODE=manual

# ── BILLING DE KOLEK (la mensualidad que la escuela le paga a Kolek) ──────
# Días de prueba gratuita al completar el onboarding.
TRIAL_DAYS=14
# Días de gracia (solo lectura + exportación) tras vencer la suscripción.
SUBSCRIPTION_GRACE_DAYS=7
# 'manual' (activación desde el panel superadmin, default) | 'mock'
BILLING_PROVIDER_MODE=manual

# ── EMAIL (Resend, opcional) ───────────────────────────────────────────────
# resend.com/api-keys — si está vacío, Kolek no manda correo (WhatsApp
# sigue siendo el canal principal).
RESEND_API_KEY=
RESEND_FROM=

# ── ANALÍTICA ───────────────────────────────────────────────────────────
# 'internal' (default: se guarda en la tabla analytics_events, sin datos
# personales) | 'disabled'
ANALYTICS_MODE=internal

# ── MODO DEMO / CRON ────────────────────────────────────────────────────
# Protege /api/cron/reminders. Vercel lo manda como Authorization: Bearer <valor>
CRON_SECRET=

# ── SUPERADMIN (panel interno del equipo de Kolek/Ravela) ─────────────────
# Lista de correos separados por coma que pueden entrar a /superadmin.
# Además de estar aquí, cada cuenta necesita profiles.is_superadmin = true
# en la base de datos (se activa a mano, nunca desde la app) — ver
# docs/security.md.
SUPERADMIN_EMAILS=

# ── RATE LIMITING (endpoints públicos anónimos: /demo, webhooks) ─────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=5
